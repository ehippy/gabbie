# Gabbie Voice Gateway Configuration
# Copy this to ~/.gabbie/config.toml and customize

[audio]
sample_rate = 16000
channels = 1
chunk_size = 1280
# input_device_index = 7   # Uncomment and set to use specific input device
# output_device_index = 8  # Uncomment and set to use specific output device
                         # Use 'gabbie devices' to find device indices

[wake_word]
model = "alexa"
threshold = 0.5        # Detection threshold (0.0 - 1.0)
vad_threshold = 0.5    # Voice activity detection threshold

[recording]
post_wake_buffer = 3       # Seconds to record after wake word
silence_threshold = 0.01   # Audio level threshold for silence
silence_duration = 0.5     # Seconds of silence to end recording

[server]
url = "http://neuralforge:8000/api/v1"
stt_model = "Whisper-Tiny"
llm_model = "Qwen3.5-122B-A10B-GGUF"
tts_model = "kokoro-v1"
tts_voice = "af_bella"

[performance]
max_retries = 3
retry_delay = 1.0
